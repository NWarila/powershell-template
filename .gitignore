# Default-deny: every tracked file must be explicitly allowlisted below.
# New files that are not allowlisted are ignored by git. After staging, run
# `git status --short` and confirm every intended file is tracked.
**

# Root files
!/.gitattributes
!/.gitignore
!/LICENSE
!/PSScriptAnalyzerSettings.psd1
!/README.md
!/SECURITY.md
!/build.ps1
!/renovate.json5

# CI and repo metadata
!/.github/
!/.github/CODEOWNERS
!/.github/.script
!/.github/.module
!/.github/workflows/
!/.github/workflows/*.yaml

# Analyzer rules
!/analyzers/
!/analyzers/*.psm1

# Module source
!/src/
!/src/**/
!/src/**/*.ps1
!/src/**/*.psd1
!/src/**/*.psm1

# Tests
!/tests/
!/tests/*.ps1

# Documentation
!/docs/
!/docs/**/
!/docs/**/*.md
!/docs/**/*.mmd
!/docs/**/*.ps1
!/docs/**/.gitkeep
